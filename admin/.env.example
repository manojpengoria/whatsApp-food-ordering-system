APP_NAME="WM Restaurant Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# The bot and the admin call each other, so let `php artisan serve` handle several requests at once.
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wm_restaurant
DB_USERNAME=wm_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- White Messenger restaurant ----
# Times are stored in UTC and shown to staff in this timezone.
RESTAURANT_TIMEZONE=Asia/Kolkata
ORDER_PREFIX=CS
# Node bot address (Laravel calls BOT_URL/internal/notify)
BOT_URL=http://127.0.0.1:3000
# Shared secret with the bot (same value in bot/.env). Make one with:  openssl rand -hex 32
WM_INTERNAL_TOKEN=
# First admin login, created by `php artisan db:seed`. Leave password empty to get a random one.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@whitemessenger.local
ADMIN_PASSWORD=

# ---- WhatsApp photo catalog ----
# Your tunnel address + /media/menu  (the bot serves menu photos there so Meta can download them)
PUBLIC_MEDIA_URL=https://YOUR-TUNNEL/media/menu
# Commerce Manager → your catalog → Settings shows the Catalog ID
META_CATALOG_ID=
# Token with catalog_management permission (System User token recommended)
META_CATALOG_TOKEN=
GRAPH_API_VERSION=v26.0
