# ---- Server ----
PORT=3000
# 127.0.0.1 = only this Mac. Your tunnel (ngrok / cloudflared) forwards Meta's webhook here.
HOST=127.0.0.1

# ---- WhatsApp Cloud API (keep your existing values) ----
# Old names shown; WHATSAPP_VERIFY_TOKEN / META_APP_SECRET / WHATSAPP_ACCESS_TOKEN /
# WHATSAPP_PHONE_NUMBER_ID / WHATSAPP_API_VERSION also work.
VERIFY_TOKEN=
APP_SECRET=
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
GRAPH_API_VERSION=

# ---- MySQL (same database and user as admin/.env) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wm_restaurant
DB_USERNAME=wm_app
DB_PASSWORD=

# ---- Laravel admin ----
LARAVEL_API_URL=http://127.0.0.1:8000/internal/v1
# Same value as WM_INTERNAL_TOKEN in admin/.env. Make one with:  openssl rand -hex 32
WM_INTERNAL_TOKEN=

# Optional: folder with menu photos. Default = ../admin/storage/app/public/menu (works when bot/ and admin/ sit side by side)
# MEDIA_DIR=
